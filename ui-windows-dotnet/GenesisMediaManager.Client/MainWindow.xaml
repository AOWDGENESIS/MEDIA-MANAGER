<Window x:Class="GenesisMediaManager.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GENESIS Media Manager" Height="900" Width="1440"
        MinHeight="720" MinWidth="1100"
        Icon="Assets/app-icon.ico"
        Background="{StaticResource BackgroundBrush}">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,2,6,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="G" FontSize="25" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GENESIS" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="MEDIA MANAGER" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <TreeView x:Name="NavTree" Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <StackPanel Grid.Row="2" Margin="6,12,6,0">
                    <TextBlock Text="LOCAL FIRST" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,6" />
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="10,8">
                        <DockPanel>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Offline-first" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,14,28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" MaxWidth="620" Height="48" CornerRadius="24"
                        Background="{StaticResource SearchBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="GlobalSearchBox"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Globale Suche: Titel, Interpret, Album, Pfad, Genre ... (§9)" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="16,0,12,0" Height="42" CornerRadius="21"
                        Background="{StaticResource StatusBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="ConnectionStatusText" Text="Verbunden" FontSize="13"
                                   Foreground="{StaticResource SuccessTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="2" Width="44" Height="44" Style="{StaticResource IconButtonStyle}"
                        ToolTip="Einstellungen" Click="ProfileButton_Click">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                </Button>
            </Grid>

            <ContentControl Grid.Row="1" x:Name="MainContent" Margin="28,0,28,28"
                            Foreground="{StaticResource TextPrimaryBrush}">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{StaticResource BackgroundBrush}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
